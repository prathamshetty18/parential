# PostgreSQL Database Connection URL (matching docker-compose service definition)
DATABASE_URL=postgresql://postgres:postgrespassword@db:5432/wini_parental_db

# Secret key for JWT authentication token signing
JWT_SECRET=your_jwt_secret_key_change_in_production_12345

# Secret provisioning key for initial Wini device registration
PROVISIONING_KEY=winiprov_secret_key_change_me
